# ─── Site ────────────────────────────────────────────────────────────────
# Canonical production origin (no trailing slash). Used for canonicals, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://ampleassociates.com
# Set to "true" ONLY on the production deployment. Anything else = robots disallow + X-Robots-Tag noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ─── Analytics (optional; loads only after cookie consent) ──────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── CMS: Sanity (optional; local typed content is used when unset) ─────
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Only needed for a private dataset. Server-side only — never prefix with NEXT_PUBLIC_.
SANITY_READ_TOKEN=
